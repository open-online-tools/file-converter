{
  "name": "file-converter-web",
  "version": "0.1.0",
  "description": "Browser-native file converter — React.js + Rust/WASM",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:wasm": "cd ../converter-wasm && wasm-pack build --target web --out-dir ../web/src/wasm",
    "build:all": "npm run build:wasm && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "vitest": "^3.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "jsdom": "^26.0.0",
    "vite": "^6.0.0"
  }
}
